# postinstall config file (shell syntax, sourced by the entrypoint).
#
# copy this, keep it out of git, chmod 600 it:
#   install -m 0600 config/postinstall.env.example config/postinstall.env
#   $EDITOR config/postinstall.env
#
# every value here can also come from the environment or a --flag.
# flags win, then this file, then the environment, then built-in defaults.
#
# ============================== identity =============================

# user that owns the box after install. gets sudo, ssh key, shells.
NEW_USER=ops

# sshd listens here. changing it from 22 is optional, the firewall follows.
SSH_PORT=22

# hostname to set. leave empty to keep whatever the provider gave you.
HOSTNAME_SET=""

# iana name, e.g. Europe/Amsterdam. empty = leave provider default.
TIMEZONE=UTC

# =============================== access =============================

# file with the public key(s) for NEW_USER. one per line.
# if it exists and is readable, it wins. falls back to /root/.ssh/authorized_keys.
SSH_PUBKEY_FILE=""

# comma or space separated allowlist. empty = only NEW_USER.
SSH_ALLOW_USERS=""

# set to 1 only if you accept password logins. keys only is the whole point.
SSH_ALLOW_PASSWORD=0

# keep tcp forwarding (-L/-R) on, needed for jumping through this box.
SSH_ALLOW_TCP_FORWARDING=1

# ============================== firewall ============================

# extra inbound tcp ports, space separated. ssh is always opened.
# cloudflare tunnel is outbound only, it needs nothing here.
EXTRA_TCP_PORTS=""

# extra inbound udp ports, space separated.
EXTRA_UDP_PORTS=""

# ================================ sudo ==============================

# 1 = passwordless sudo for NEW_USER. 0 = keep the password prompt.
SUDO_NOPASSWD=0

# =============================== modules ============================
# 1 = run, 0 = skip. --only/--skip override these.

ENABLE_USERS=1
ENABLE_FIREWALL=1
ENABLE_SSH=1
ENABLE_FAIL2BAN=1
ENABLE_SYSCTL=1
ENABLE_UPDATES=1
ENABLE_TOOLS=1
ENABLE_SHELL=1
ENABLE_DOCKER=1
ENABLE_PYTHON=1
ENABLE_NODE=0
ENABLE_GO=0
ENABLE_CLOUDFLARED=0
ENABLE_WARP=0
ENABLE_DOTFILES=0
ENABLE_VERIFY=1

# ============================== docker ==============================

# adding a user to the docker group is root-equivalent access. on purpose here.
DOCKER_ADD_USER_TO_GROUP=1

# ============================== python ==============================

# install uv from astral into /usr/local/bin
PYTHON_INSTALL_UV=1

# =============================== node ===============================

# nodesource major version. 24 is the current lts.
NODE_MAJOR=24

# ============================= cloudflare ===========================

# preferred: path to a 0600 file holding the tunnel token.
CLOUDFLARED_TOKEN_FILE=""

# fallback for lazy shells. shows up in `ps`, avoid it.
CLOUDFLARED_TOKEN=""

# warp / cloudflare mesh connector token (zero trust > networks > connectors).
CLOUDFLARE_WARP_TOKEN_FILE=""
CLOUDFLARE_WARP_TOKEN=""

# upstream has no trixie repo yet, bookworm package runs fine.
WARP_CODENAME=bookworm

# ============================== dotfiles ============================

# git url, cloned as NEW_USER when ENABLE_DOTFILES=1
DOTFILES_REPO=""
DOTFILES_DIR=""

# optional command run inside the dotfiles dir, as NEW_USER.
# e.g. "./install.sh"
DOTFILES_INSTALL_CMD=""

# pull instead of clone when the dir already exists.
DOTFILES_UPDATE=1
