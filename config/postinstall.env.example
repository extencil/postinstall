# postinstall config file (shell syntax, sourced by the entrypoint).
#
# copy this, keep it out of git, chmod 600 it:
#   install -m 0600 config/postinstall.env.example config/postinstall.env
#   $EDITOR config/postinstall.env
#
# every value here can also come from the environment or a --flag.
# flags win, then this file, then the environment, then built-in defaults.
#
# ============================== identity =============================

# user that owns the box after install. gets sudo, ssh key, shells.
NEW_USER=ops

# local sudo password for NEW_USER. SSH stays public-key only either way.
# precedence: NEW_USER_PASSWORD, then NEW_USER_PASSWORD_FILE, then generate.
NEW_USER_PASSWORD=""

# recommended way to choose a known password: point here at a 0400/0600 file.
# relative paths resolve against the repo. if missing, a 64-char hex password is
# generated and stored here. empty = /root/postinstall-<user>.password.
NEW_USER_PASSWORD_FILE=""

# provider accounts to neuter after NEW_USER has a usable key: nologin shell,
# locked password, expired account, no sudo/docker group, no sudoers grant and
# a DenyUsers entry in sshd. empty disables this. never list NEW_USER here.
DISABLE_DEFAULT_USERS=debian

# 1 = lock the root password after NEW_USER has sudo. 0 is only for a staged
# POC where you still want root password recovery on the provider console.
LOCK_ROOT_PASSWORD=1

# real ssh listens here. the decoy owns 22/tcp; the firewall follows.
SSH_PORT=1

# hostname to set. leave empty to keep whatever the provider gave you.
HOSTNAME_SET=""

# iana name, e.g. Europe/Amsterdam. empty = leave provider default.
TIMEZONE=UTC

# =============================== access =============================

# inline public key for NEW_USER, one line. this wins over SSH_PUBKEY_FILE.
# keep the private key off the server and out of this repo.
SSH_PUBKEY=""

# file with the public key(s) for NEW_USER. one per line. relative paths resolve
# against the repo. an explicitly set path that is missing or malformed aborts.
# when both inline and file are empty, an existing key is left alone, then the
# fallback is /root/.ssh/authorized_keys.
SSH_PUBKEY_FILE=""

# comma or space separated allowlist. empty = only NEW_USER.
SSH_ALLOW_USERS=""

# set to 1 only if you accept password logins. keys only is the whole point.
SSH_ALLOW_PASSWORD=0

# keep tcp forwarding (-L/-R) on, needed for jumping through this box.
SSH_ALLOW_TCP_FORWARDING=1

# optional UTF-8 banner file for the reject-only decoy, at most 16384 bytes.
# empty uses assets/ssh-prank/banner.txt. only public text belongs here.
SSH_PRANK_BANNER_FILE=""

# ============================== firewall ============================

# extra inbound tcp ports, space separated. ssh is always opened.
# cloudflare tunnel is outbound only, it needs nothing here.
EXTRA_TCP_PORTS=""

# extra inbound udp ports, space separated.
EXTRA_UDP_PORTS=""

# ================================ sudo ==============================

# 0 = sudo asks for NEW_USER_PASSWORD_FILE. 1 = passwordless sudo.
# this never changes SSH auth; sshd stays public-key only.
SUDO_NOPASSWD=0

# =============================== modules ============================
# 1 = run, 0 = skip. --only/--skip override these.

ENABLE_USERS=1
ENABLE_FIREWALL=1
ENABLE_SSH=1
# reject-only ssh on 22/tcp; needs real ssh on a different port.
ENABLE_SSH_PRANK=1
ENABLE_FAIL2BAN=1
ENABLE_SYSCTL=1
ENABLE_UPDATES=1
ENABLE_TOOLS=1
ENABLE_SHELL=1
ENABLE_DOCKER=1
ENABLE_PYTHON=1
ENABLE_NODE=0
ENABLE_GO=0
ENABLE_CLOUDFLARED=0
ENABLE_DOTFILES=0
ENABLE_VERIFY=1

# ============================== docker ==============================

# adding a user to the docker group is root-equivalent access. on purpose here.
DOCKER_ADD_USER_TO_GROUP=1

# ============================== python ==============================

# install uv from astral into /usr/local/bin
PYTHON_INSTALL_UV=1

# =============================== node ===============================

# nodesource major version. 24 is the current lts.
NODE_MAJOR=24

# ============================= cloudflare ===========================

# remotely managed tunnel, installed as a host service. create it in the
# dashboard, name it after the server hostname, pick debian 64-bit.
#
# preferred: path to a 0400/0600 file holding the tunnel token.
CLOUDFLARED_TOKEN_FILE=""

# fallback for lazy shells. shows up in `ps`, avoid it.
CLOUDFLARED_TOKEN=""

# ============================== dotfiles ============================

# git url, cloned as NEW_USER when ENABLE_DOTFILES=1
DOTFILES_REPO=""
DOTFILES_DIR=""

# optional command run inside the dotfiles dir, as NEW_USER.
# e.g. "./install.sh"
DOTFILES_INSTALL_CMD=""

# pull instead of clone when the dir already exists.
DOTFILES_UPDATE=1
